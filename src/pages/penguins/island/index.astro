---
import penguins from "../../../assets/penguins.json";
import Layout from "../../../layouts/Layout.astro";

// Extraction et tri des îles uniques (j'ai renommé la variable pour plus de clarté)
const islands = [...new Set(penguins.map((p) => p.island))].sort();
---

<Layout>
  <div class="max-w-5xl mx-auto px-4 py-10">
    <header class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold text-slate-900">Pingouins par Île</h1>
      <p class="text-slate-600 mt-2 text-lg">
        Sélectionnez une île pour visualiser les données des pingouins qui y
        résident.
      </p>
    </header>

    <!-- Grille adaptative pour les îles -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {
        islands.map((island) => (
          <li>
            <a
              href={`/penguins/island/${island}`}
              class="block bg-white border border-slate-200 rounded-xl p-6 text-center shadow-sm transition-all duration-200 hover:shadow-md hover:border-indigo-400 hover:-translate-y-1 group"
            >
              <span class="block text-3xl mb-3">🏝️</span>
              <span class="font-semibold text-xl text-slate-700 group-hover:text-indigo-600 transition-colors">
                Île de {island}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
