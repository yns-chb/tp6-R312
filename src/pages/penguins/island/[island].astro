---
import penguins from "../../../assets/penguins.json";
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

export const prerender = true;

export function getStaticPaths() {
  return [
    // { params: { /* requis */ }, props: { /* facultatif */ } },
    { params: { island: "Torgersen" } }, // [post] est le paramètre
    { params: { island: "Biscoe" } }, // doit correspondre au nom du fichier
    { params: { island: "Dream" } }, // doit correspondre au nom du fichier
    { params: { island: "Gentoo" } }, // doit correspondre au nom du fichier
    { params: { island: "King" } }, // doit correspondre au nom du fichier
    // ...
  ];
}

const { island } = Astro.params;

// Filtrer les pingouins pour l'île spécifiée
const filteredPenguins = penguins.filter((p) => p.island === island);

// Configuration du graphique
const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Culmen Length (mm)",
  },
  y: {
    label: "Culmen Depth (mm)",
  },
  title: `Relation Culmen Length vs Culmen Depth - Pingouins ${island}`,
};
---

<Layout>
  <div class="max-w-5xl mx-auto px-4 py-10">
    <!-- Bouton de retour vers l'index des îles -->
    <a
      href="/penguins/island"
      class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors mb-6 group"
    >
      <svg
        class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Retour à la liste des îles
    </a>

    <!-- En-tête -->
    <header class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold text-slate-900">
        Pingouins de l'île {island}
      </h1>
      <p class="text-slate-600 mt-2 text-lg">
        <span class="font-semibold text-indigo-600"
          >{filteredPenguins.length}</span
        > pingouin(s) trouvé(s) sur cette île.
      </p>
    </header>

    <!-- Carte contenant le graphique -->
    <div
      class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 overflow-x-auto"
    >
      <PlotFigure options={plotOptions} />
    </div>
  </div>
</Layout>
