---
import penguins from "../../assets/penguins.json";
export const prerender = false;
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
const { island } = Astro.params;
// Filtrer les pingouins pour l'île spécifiée
const filteredPenguins = penguins.filter((p) => p.island === island);
// Configuration du graphique
const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredPenguins, {
      x: "body_mass_g",
      y: "flipper_length_mm",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Poids (g)",
  },
  y: {
    label: "Longueur de la nageoire (mm)",
  },
  title: `Relation Longueur de la nageoire vs Poids - Pingouins ${island}`,
};
---

<h1>Pingouins de l'île {island}</h1>
<p>{filteredPenguins.length} pingouin(s) trouvée(s) pour l'île {island}</p>

<PlotFigure options={plotOptions} />