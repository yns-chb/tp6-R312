---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <!-- Conteneur principal centré -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- En-tête de la page -->
    <header class="mb-12 text-center">
      <h1
        class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-4"
      >
        Tableau de Bord Data
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Exploration visuelle des données avec Astro, Tailwind CSS et Observable
        Plot.
      </p>
    </header>

    <!-- Section Graphique Principal (Mise en avant) -->
    <section
      class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 mb-12"
    >
      <div class="mb-6 border-b border-slate-100 pb-4">
        <h2 class="text-2xl font-semibold text-slate-800">
          Aperçu : Morphologie des Pingouins
        </h2>
        <p class="text-slate-500 text-sm mt-1">
          Relation entre la longueur et la profondeur du bec selon l'espèce.
        </p>
      </div>

      <!-- Conteneur pour centrer le graphique et permettre le scroll sur mobile -->
      <div class="flex justify-center overflow-x-auto">
        <PlotFigure
          options={{
            grid: true,
            color: { legend: true }, // Ajoute une légende pour les espèces si ton composant le supporte
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
                r: 4, // Augmente légèrement la taille des points
              }),
            ],
          }}
        />
      </div>
    </section>

    <!-- Section Navigation Rapide -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Carte Navigation Voitures -->
      <a href="/cars/year" class="block group">
        <div
          class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 h-full transition-all duration-300 hover:shadow-md hover:border-indigo-300 hover:-translate-y-1"
        >
          <h3
            class="text-xl font-bold text-slate-800 mb-2 group-hover:text-indigo-600 transition-colors"
          >
            🚗 Analyse des Voitures
          </h3>
          <p class="text-slate-600">
            Parcourez les données des véhicules classées par année de
            production.
          </p>
        </div>
      </a>

      <!-- Carte Navigation Pingouins -->
      <a href="/penguins/island" class="block group">
        <div
          class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 h-full transition-all duration-300 hover:shadow-md hover:border-indigo-300 hover:-translate-y-1"
        >
          <h3
            class="text-xl font-bold text-slate-800 mb-2 group-hover:text-indigo-600 transition-colors"
          >
            🐧 Données des Pingouins
          </h3>
          <p class="text-slate-600">
            Explorez la base de données Palmer en filtrant par île ou par sexe.
          </p>
        </div>
      </a>
    </section>
  </main>
</Layout>
